
static Color =
    .Red
  | .Blue
  | .Green

func print_color(c: Color)
  match c
    .Red -> print("Red")
    .Blue -> print("Blue")
    .Green -> print("Green")

func foo (x: func(Color) unit, y: Color) -> x(y)

const clos = (x: Color) => print_color(x)

foo(clos, .Blue)

const col = Color.Red
const cl = () => print_color(col)
cl()
