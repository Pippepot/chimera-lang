import std.memory.{Span, SpanIterator}
import std.range.{Range, FromEnd}

pub struct collection_literal(T: type, N: int)
    move = none
    copy = none

pub struct Array(T: type, N: int)
    pub func filled(imm value: T) Array(T, N) where T.copy is func(imm T) T -> array_filled(T, N, value)
    pub func len(imm self: Array(T, N)) int -> N
    pub func span(ref self: Array(T, N)) Span(T) -> Span(T).from_array(N, self)
    pub func iter(ref self: Array(T, N)) SpanIterator(T)
        var view = self.span()
        return view.iter()
    pub func slice(ref self: Array(T, N), bounds: Range) Span(T) | none
        var view = self.span()
        return view.slice(bounds)

    func get_at(ref self: Array(T, N), index: int) ref T | none
        if index < 0 or index >= N -> return none
        return array_borrow(T, N, self, index)
    func get_from_end(ref self: Array(T, N), index: FromEnd) ref T | none
        const resolved: int = index.resolve(N) else return none
        return self.get_at(resolved)
    pub overload get(get_at, get_from_end)

    func at(ref self: Array(T, N), index: int) ref T
        if index < 0 or index >= N -> panic "Array index out of bounds"
        return array_borrow(T, N, self, index)
    func at_from_end(ref self: Array(T, N), index: FromEnd) ref T
        const resolved: int = index.resolve(N) else panic "Array index out of bounds"
        return self.at(resolved)
    func slice_at(ref self: Array(T, N), bounds: Range) Span(T)
        var view: Span(T) = self.slice(bounds) else panic "Array slice out of bounds"
        return view
    pub overload [](at, at_from_end, slice_at)

    pub func []=(static Index: type, mut self: Array(T, N), index: Index, var value: T) unit where Index is int or Index is FromEnd
        ref element = self[index]
        element = value^

extern func array_filled(static T: type, static N: int, imm value: T) Array(T, N)
extern func array_from(static T: type, static N: int, init value: collection_literal(T, N)) Array(T, N)
pub converter(static T: type, static N: int, init value: collection_literal(T, N)) Array(T, N) -> array_from(T, N, value)
extern func array_borrow(static T: type, static N: int, ref value: Array(T, N), index: int) ref T
