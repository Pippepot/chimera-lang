import std.memory.{List, Span, SpanIterator}
import std.range.{Range, FromEnd}
import std.search
import std.ownership.{copyable, movable}

pub struct collection_literal(T: type, N: int)
    move = none
    copy = none

pub struct Array(T: type, N: int)
    pub func filled(imm value: T) Array(T, N) where copyable(T) -> array_filled(T, N, value)
    pub func len(imm self: Array(T, N)) int -> N
    pub func reverse(mut self: Array(T, N)) unit where movable(T)
        var view = self.span()
        view.reverse()
    func sort_default(mut self: Array(T, N)) unit where movable(T)
        var view = self.span()
        return view.sort()
    func sort_by(mut self: Array(T, N), before: func(imm T, imm T) bool) unit where movable(T)
        var view = self.span()
        return view.sort(before)
    func sort_static(mut self: Array(T, N), static Element: type, static before: func(imm Element, imm Element) bool) unit where movable(T) and Element == T
        var view = self.span()
        return view.sort(Element, before)
    pub overload sort(sort_default, sort_by, sort_static)
    func sorted_default(imm self: Array(T, N)) List(T) | none where copyable(T) and movable(T)
        return self.span().sorted()
    func sorted_by(imm self: Array(T, N), before: func(imm T, imm T) bool) List(T) | none where copyable(T) and movable(T)
        return self.span().sorted(before)
    func sorted_static(imm self: Array(T, N), static Element: type, static before: func(imm Element, imm Element) bool) List(T) | none where copyable(T) and movable(T) and Element == T
        return self.span().sorted(Element, before)
    pub overload sorted(sorted_default, sorted_by, sorted_static)
    pub func span(ref self: Array(T, N)) Span(T) -> Span(T).from_array(N, self)
    func index_of_equal(static Needle: type, imm self: Array(T, N), imm needle: Needle) int | none -> std.search.index_of(self.span(), needle)
    func index_of_by(static Needle: type, imm self: Array(T, N), imm needle: Needle, matches: func(imm T, imm Needle) bool) int | none -> std.search.index_of(self.span(), needle, matches)
    pub overload index_of(index_of_equal, index_of_by)
    func index_of_sequence_equal(static Needle: type, imm self: Array(T, N), imm needle: Span(Needle)) int | none -> std.search.index_of_sequence(self.span(), needle)
    func index_of_sequence_by(static Needle: type, imm self: Array(T, N), imm needle: Span(Needle), matches: func(imm T, imm Needle) bool) int | none -> std.search.index_of_sequence(self.span(), needle, matches)
    pub overload index_of_sequence(index_of_sequence_equal, index_of_sequence_by)
    pub func iter(ref self: Array(T, N)) SpanIterator(T)
        var view = self.span()
        return view.iter()
    pub func slice(ref self: Array(T, N), bounds: Range) Span(T) | none
        var view = self.span()
        return view.slice(bounds)

    # No bounds check: `index` must satisfy 0 <= index < N. Violations are undefined behavior.
    pub func unsafe_at(ref self: Array(T, N), index: int) ref T -> array_borrow(T, N, self, index)
    func get_at(ref self: Array(T, N), index: int) ref T | none
        if index < 0 or index >= N -> return none
        return array_borrow(T, N, self, index)
    func get_from_end(ref self: Array(T, N), index: FromEnd) ref T | none
        const resolved = index.resolve(N)
        if not (resolved is int) -> return none
        return self.get_at(resolved)
    pub overload get(get_at, get_from_end)

    func at(ref self: Array(T, N), index: int) ref T
        if index < 0 or index >= N -> panic "Array index out of bounds"
        return array_borrow(T, N, self, index)
    func at_from_end(ref self: Array(T, N), index: FromEnd) ref T
        const resolved = index.resolve(N)
        if not (resolved is int) -> panic "Array index out of bounds"
        return self.at(resolved)
    func slice_at(ref self: Array(T, N), bounds: Range) Span(T)
        var view = self.slice(bounds)
        if not (view is Span(T)) -> panic "Array slice out of bounds"
        return view
    pub overload [](at, at_from_end, slice_at)

    pub func []=(static Index: type, mut self: Array(T, N), index: Index, var value: T) unit where Index is int or Index is FromEnd
        ref element = self[index]
        element = value^

pub converter(static T: type, static N: int, init value: collection_literal(T, N)) Array(T, N) -> value
extern func array_filled(static T: type, static N: int, imm value: T) Array(T, N)
extern func array_borrow(static T: type, static N: int, ref value: Array(T, N), index: int) ref T
