pub func min(static T: type, imm left: T, imm right: T) T
    if left < right -> return left
    return right

pub func max(static T: type, imm left: T, imm right: T) T
    if left > right -> return left
    return right

pub func clamp(static T: type, imm value: T, imm lower: T, imm upper: T) T
    return max(min(value, upper), lower)

# Keep the common int specializations in the precompiled standard library.
func precompile_int_math() (func(int, int) int, func(int, int) int, func(int, int, int) int)
    return (min, max, clamp)
