pub extern fallible int.<>(imm left: int, imm right: int) unit
pub extern fallible int.<(imm left: int, imm right: int) unit
pub extern fallible int.>(imm left: int, imm right: int) unit
pub extern fallible int.<=(imm left: int, imm right: int) unit
