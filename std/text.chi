import std.memory.{AllocationError, Allocation, Span, List, Box, Ref, allocate, allocate_with, deallocate, unsafe_initialize}
import std.array.{Array, collection_literal}
import std.range.{Range, FromEnd}
import std.search
import std.io.{IoError}

pub extern func byte_int(value: byte) int
extern func io_write(descriptor: int, imm data: Span(byte)) int | IoError
extern func panic_message(imm message: StringView) never

pub struct Utf8Error
    error = true
    copy = fieldwise
    pub index: int

pub struct BytesView
    copy = trivial
    data: Span(byte)
    pub func from_array(static N: int, ref value: Array(byte, N)) BytesView -> BytesView{data = Span(byte).from_array(N, value).as_imm()}
    pub func unsafe_from_allocation(ref value: Allocation(byte), initialized: int) BytesView | none
        const view = Span(byte).unsafe_from_allocation(value, initialized)
        if not (view is Span(byte)) -> return none
        return BytesView{data = view.as_imm()}
    pub func from_span(imm span: Span(byte)) BytesView -> BytesView{data = span.as_imm()}
    pub func as_span(imm self: BytesView) Span(byte) -> self.data.as_imm()
    pub func write_to(imm self: BytesView, descriptor: int) int | IoError -> io_write(descriptor, self.data)
    pub func byte_length(imm self: BytesView) int -> self.data.len()
    func get_at(imm self: BytesView, index: int) ref byte | none -> self.data.get(index)
    func get_from_end(imm self: BytesView, index: FromEnd) ref byte | none -> self.data.get(index)
    pub overload get(get_at, get_from_end)
    func at(imm self: BytesView, index: int) ref byte
        const selected_item_2 = self.get(index)
        if not (selected_item_2 is byte) -> panic "BytesView index out of bounds"
        ref item = selected_item_2
        return item
    func at_from_end(imm self: BytesView, index: FromEnd) ref byte
        const selected_item_3 = self.get(index)
        if not (selected_item_3 is byte) -> panic "BytesView index out of bounds"
        ref item = selected_item_3
        return item
    func slice_at(imm self: BytesView, bounds: Range) BytesView
        const view = self.slice(bounds)
        if not (view is BytesView) -> panic "BytesView slice out of bounds"
        return view
    pub overload [](at, at_from_end, slice_at)
    pub func slice(imm self: BytesView, bounds: Range) BytesView | none
        const view = self.data.slice(bounds)
        if not (view is Span(byte)) -> return none
        return BytesView{data = view}
    pub func validate_utf8(imm self: BytesView) StringView | Utf8Error
        var index = 0
        loop
            if index == self.byte_length() -> break
            const sequence_start = index
            const first = byte_int(self[index])
            index += 1
            if first >= 128
                var continuation = 0
                var minimum = 128
                var maximum = 191
                match first
                    194..=223 -> continuation = 1
                    224..=239 ->
                        continuation = 2
                        if first == 224 -> minimum = 160
                        if first == 237 -> maximum = 159
                    240..=244 ->
                        continuation = 3
                        if first == 240 -> minimum = 144
                        if first == 244 -> maximum = 143
                    _ -> return Utf8Error{index = sequence_start}
                if continuation > self.byte_length() - index -> return Utf8Error{index = sequence_start}
                const second = byte_int(self[index])
                if second < minimum or second > maximum -> return Utf8Error{index = sequence_start}
                index += 1
                for _ in 1..continuation
                    const next = byte_int(self[index])
                    if next < 128 or next > 191 -> return Utf8Error{index = sequence_start}
                    index += 1
        return StringView{bytes = self}

pub struct StringView
    copy = trivial
    bytes: BytesView
    pub func ==(imm left: StringView, imm right: StringView) bool -> equal_bytes(left.bytes, right.bytes)
    pub func <>(imm left: StringView, imm right: StringView) bool -> not equal_bytes(left.bytes, right.bytes)
    pub func byte_length(imm self: StringView) int -> self.bytes.byte_length()
    pub func as_bytes(imm self: StringView) BytesView -> self.bytes
    pub func find(imm self: StringView, imm needle: StringView) int | none -> std.search.index_of_sequence(self.bytes.as_span(), needle.bytes.as_span())
    pub func contains(imm self: StringView, imm needle: StringView) bool -> self.find(needle) is int
    pub func starts_with(imm self: StringView, imm needle: StringView) bool -> std.search.starts_with(self.bytes.as_span(), needle.bytes.as_span())
    pub func ends_with(imm self: StringView, imm needle: StringView) bool -> std.search.ends_with(self.bytes.as_span(), needle.bytes.as_span())
    func slice_at(imm self: StringView, bounds: Range) StringView
        const view = self.slice(bounds)
        if not (view is StringView) -> panic "StringView slice out of bounds"
        return view
    pub overload [](slice_at)
    pub func slice(imm self: StringView, bounds: Range) StringView | none
        const offsets = bounds.resolve(self.byte_length())
        if not (offsets is (int, int)) -> return none
        const start = offsets.0
        const end = offsets.1
        if start < self.byte_length()
            const first = byte_int(self.bytes[start])
            if first >= 128 and first < 192 -> return none
        if end < self.byte_length()
            const last = byte_int(self.bytes[end])
            if last >= 128 and last < 192 -> return none
        const view = self.bytes.slice(bounds)
        if not (view is BytesView) -> return none
        return StringView{bytes = view}

pub struct StaticString
    copy = trivial
    bytes: Span(byte)
    pub func byte_length(imm self: StaticString) int -> self.bytes.len()
    pub func as_bytes(imm self: StaticString) BytesView -> BytesView{data = self.bytes}
    pub func view(imm self: StaticString) StringView -> StringView{bytes = self.as_bytes()}
    pub func find(imm self: StaticString, imm needle: StringView) int | none -> self.view().find(needle)
    pub func contains(imm self: StaticString, imm needle: StringView) bool -> self.view().contains(needle)
    pub func starts_with(imm self: StaticString, imm needle: StringView) bool -> self.view().starts_with(needle)
    pub func ends_with(imm self: StaticString, imm needle: StringView) bool -> self.view().ends_with(needle)

struct OwnedBytes
    copy = none
    allocation: Allocation(byte)
    size: int
    drop = func(deinit self: OwnedBytes) -> deallocate(byte, self.allocation^)

pub struct String
    copy = none
    storage: StaticString | OwnedBytes
    pub func ==(imm left: String, imm right: StringView) bool -> equal_bytes(left.as_bytes(), right.as_bytes())
    pub func <>(imm left: String, imm right: StringView) bool -> not equal_bytes(left.as_bytes(), right.as_bytes())
    pub func from_utf8(imm bytes: BytesView) String | AllocationError | Utf8Error
        const text = bytes.validate_utf8()?
        var result = String.empty()
        _ = result.append(text)?
        return result^
    pub func empty() String -> String{storage = ""}
    pub func byte_length(imm self: String) int
        return match self.storage
            StaticString -> self.storage.byte_length()
            OwnedBytes -> self.storage.size
    pub func capacity(imm self: String) int
        return match self.storage
            StaticString -> self.storage.byte_length()
            OwnedBytes -> self.storage.allocation.capacity()
    pub func as_bytes(imm self: String) BytesView
        match self.storage
            StaticString -> return self.storage.as_bytes()
            OwnedBytes ->
                ref owned = self.storage
                const bytes = BytesView.unsafe_from_allocation(owned.allocation, owned.size)
                if not (bytes is BytesView) -> panic "invalid String byte view"
                return bytes
    pub func view(imm self: String) StringView -> StringView{bytes = self.as_bytes()}
    pub func find(imm self: String, imm needle: StringView) int | none -> self.view().find(needle)
    pub func contains(imm self: String, imm needle: StringView) bool -> self.view().contains(needle)
    pub func starts_with(imm self: String, imm needle: StringView) bool -> self.view().starts_with(needle)
    pub func ends_with(imm self: String, imm needle: StringView) bool -> self.view().ends_with(needle)
    pub func reserve(mut self: String, minimum_capacity: int) unit | AllocationError
        if minimum_capacity < 0 -> return AllocationError.invalid_layout
        if minimum_capacity <= self.capacity() -> return unit
        const size = self.byte_length()
        var capacity = minimum_capacity
        if capacity < size -> capacity = size
        const storage = if self.storage is OwnedBytes -> self.storage.allocation.allocate_replacement(capacity) else allocate(byte, capacity)
        if storage is AllocationError -> return storage^
        var replacement = OwnedBytes{allocation = storage^, size = 0}
        const bytes = self.as_bytes()
        for index in 0..size
            unsafe_initialize(byte, replacement.allocation, index, bytes[index])
        replacement.size = size
        self.storage = replacement^
        return unit
    pub func append(mut self: String, imm text: StringView) unit | AllocationError
        const count = text.byte_length()
        if count == 0 -> return unit
        const size = self.byte_length()
        if count > 2147483647 - size -> return AllocationError.size_limit
        const required = size + count
        var capacity = self.capacity()
        if capacity < required
            if capacity <= 1073741823 -> capacity *= 2
            else capacity = 2147483647
            if capacity < required -> capacity = required
        _ = self.reserve(capacity)?
        const bytes = text.as_bytes()
        if self.storage is OwnedBytes
            ref owned = self.storage
            for index in 0..count
                unsafe_initialize(byte, owned.allocation, size + index, bytes[index])
            owned.size = required
            return unit
        panic "invalid String storage during append"
    pub func clear(mut self: String)
        if self.storage is OwnedBytes -> self.storage.size = 0
        else self.storage = ""
    pub func clone(imm self: String) String | AllocationError
        var result = String.empty()
        _ = result.append(self.view())?
        return result^

func equal_bytes(imm left: BytesView, imm right: BytesView) bool
    const count = left.byte_length()
    if count <> right.byte_length() -> return false
    for index in 0..count
        if byte_int(left[index]) <> byte_int(right[index]) -> return false
    return true
func match_literal(static T: type, imm value: T, imm literal: StaticString) bool -> equal_bytes(value.as_bytes(), literal.as_bytes())

pub converter(imm value: StaticString) String -> String{storage = value}
pub converter(imm value: StaticString) StringView -> value.view()
pub converter(imm value: StaticString) BytesView -> value.as_bytes()
pub converter(imm value: String) StringView -> value.view()
pub converter(imm value: String) BytesView -> value.as_bytes()
pub converter(imm value: StringView) String
    var result = String.empty()
    if not (result.append(value) is unit) -> panic "string conversion allocation failed"
    return result^
pub converter(value: int) String -> require_string(format_integer(value))
pub converter(value: byte) String -> String(byte_int(value))
pub converter(value: bool) String -> if value -> "true" else "false"
pub converter(value: unit) String -> "()"
pub converter(value: none) String -> "none"
pub converter(static T: type, static N: int, init value: collection_literal(T, N)) String
    const values: Array(T, N) = value
    return String(values)
pub converter(static T: type, static N: int, imm value: Array(T, N)) String -> require_string(format_span_using(T, value.span(), format_converted))
pub converter(static T: type, imm value: List(T)) String -> require_string(format_span_using(T, value.span(), format_converted))
pub converter(static T: type, imm value: Span(T)) String -> require_string(format_span_using(T, value, format_converted))
pub converter(imm value: BytesView) String -> String(value.as_span())
pub converter(static T: type, imm value: Box(T)) String -> require_string(format_wrapped_using(T, "Box(", value.borrow(), format_converted))
pub converter(static T: type, imm value: Ref(T)) String -> require_string(format_wrapped_using(T, "Ref(", value.value, format_converted))

func require_string(deinit result: String | AllocationError) String
    match result
        String -> return result^
        AllocationError -> panic "string conversion allocation failed"

# Decimal formatting has bounded stack storage, including -2147483648.
pub struct IntegerText
    copy = fieldwise
    buffer: Array(byte, 11)
    size: int
    pub func view(imm self: IntegerText) StringView
        const bytes = BytesView.from_array(11, self.buffer)
        const prefix = bytes.slice(0..self.size)
        if not (prefix is BytesView) -> panic "invalid integer text length"
        return StringView{bytes = prefix}

pub func integer_text(value: int) IntegerText
    const digits: BytesView = "0123456789-"
    var result = IntegerText{buffer = Array(byte, 11).filled(digits[0]), size = 0}
    var remaining = value
    if remaining < 0
        result.buffer[result.size] = digits[10]
        result.size += 1
    if remaining > 0 -> remaining = -remaining
    var divisor = 1
    loop
        if remaining / divisor >= -9 -> break
        divisor *= 10
    loop
        const digit = -(remaining / divisor)
        result.buffer[result.size] = digits[digit]
        result.size += 1
        if divisor == 1 -> break
        remaining %= divisor
        divisor /= 10
    return result^

func format_integer(value: int) String | AllocationError
    const text = integer_text(value)
    return format_view(text.view())

pub overload format(format_integer, format_byte, format_bool, format_unit, format_none, format_static, format_view, format_string, format_array, format_list, format_span, format_bytes, format_box, format_ref)
func format_converted(static T: type, imm value: T) String | AllocationError
    if value is String -> return require_string(value.clone())
    return String(value)
func format_byte(value: byte) String | AllocationError -> format_integer(byte_int(value))
func format_bool(value: bool) String | AllocationError -> if value -> "true" else "false"
func format_unit(value: unit) String | AllocationError -> "()"
func format_none(value: none) String | AllocationError -> "none"
func format_static(imm value: StaticString) String | AllocationError -> String{storage = value}
func format_view(imm value: StringView) String | AllocationError
    var result = String.empty()
    _ = result.append(value)?
    return result^
func format_string(imm value: String) String | AllocationError -> value.clone()
func format_array(static T: type, static N: int, imm value: Array(T, N)) String | AllocationError -> format_span(value.span())
func format_list(static T: type, imm value: List(T)) String | AllocationError -> format_span(value.span())
func format_bytes(imm value: BytesView) String | AllocationError -> format_span(value.as_span())
func format_box(static T: type, imm value: Box(T)) String | AllocationError -> format_wrapped("Box(", value.borrow())
func format_ref(static T: type, imm value: Ref(T)) String | AllocationError -> format_wrapped("Ref(", value.value)

func format_span(static T: type, imm values: Span(T)) String | AllocationError -> format_span_using(T, values, format)
func format_span_using(static T: type, imm values: Span(T), static render: func(imm T) String | AllocationError) String | AllocationError
    var result = "["
    var separator: StringView = ""
    for value in values
        _ = result.append(separator)?
        const text = render(value)?
        _ = result.append(text.view())?
        separator = ", "
    _ = result.append("]")?
    return result^
func format_wrapped(static T: type, imm prefix: StringView, imm value: T) String | AllocationError -> format_wrapped_using(T, prefix, value, format)
func format_wrapped_using(static T: type, imm prefix: StringView, imm value: T, static render: func(imm T) String | AllocationError) String | AllocationError
    var result = String.empty()
    _ = result.append(prefix)?
    const text = render(value)?
    _ = result.append(text.view())?
    _ = result.append(")")?
    return result^
