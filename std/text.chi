import std.memory.{Allocation, Span, allocate, deallocate, unsafe_initialize}
import std.array.{Array}
import std.range.{Range}

extern func literal_data(static value: string_literal) static_data
extern func literal_size(static value: string_literal) int
pub extern func byte_int(value: byte) int
extern fallible io_write(descriptor: int, imm data: Span(byte)) int
extern func panic_message(imm message: StringView) never

pub struct BytesView
    copy = trivial
    data: Span(byte)

    pub func from_array(static N: int, ref value: Array(byte, N)) BytesView -> BytesView{data = Span(byte).from_array(N, value).as_imm()}
    pub fallible unsafe_from_allocation(ref value: Allocation(byte), initialized: int) BytesView
        return BytesView{data = Span(byte).unsafe_from_allocation?(value, initialized).as_imm()}
    pub func from_span(imm span: Span(byte)) BytesView -> BytesView{data = span.as_imm()}
    pub func as_span(imm self: BytesView) Span(byte) -> self.data.as_imm()
    pub fallible write_to(imm self: BytesView, descriptor: int) int -> io_write?(descriptor, self.data)
    pub func byte_length(imm self: BytesView) int -> self.data.len()
    pub fallible get(imm self: BytesView, index: int) ref byte -> self.data.get?(index)
    pub fallible [](imm self: BytesView, index: int) ref byte -> self.get?(index)
    pub fallible slice(imm self: BytesView, static A: type, static B: type, bounds: Range(A, B)) BytesView
        return BytesView{data = self.data.slice?(bounds)}
    pub fallible validate_utf8(imm self: BytesView) StringView
        var index = 0
        loop
            if index == self.byte_length() -> break
            const first = byte_int(self.get?(index))
            index += 1
            if first >= 128
                var continuation = 0
                var minimum = 128
                var maximum = 191
                if first >= 194 and first <= 223 -> continuation = 1
                else if first >= 224 and first <= 239
                    continuation = 2
                    if first == 224 -> minimum = 160
                    if first == 237 -> maximum = 159
                else if first >= 240 and first <= 244
                    continuation = 3
                    if first == 240 -> minimum = 144
                    if first == 244 -> maximum = 143
                else
                    fail
                continuation <= self.byte_length() - index
                const second = byte_int(self.get?(index))
                second >= minimum
                second <= maximum
                index += 1
                continuation -= 1
                loop
                    if continuation == 0 -> break
                    const next = byte_int(self.get?(index))
                    next >= 128
                    next <= 191
                    index += 1
                    continuation -= 1
        return StringView{bytes = self}

pub struct StringView
    copy = trivial
    bytes: BytesView

    pub fallible ==(imm left: StringView, imm right: StringView) unit -> equal_bytes?(left.bytes, right.bytes)
    pub fallible <>(imm left: StringView, imm right: StringView) unit -> not equal_bytes?(left.bytes, right.bytes)
    pub func byte_length(imm self: StringView) int -> self.bytes.byte_length()
    pub func as_bytes(imm self: StringView) BytesView -> self.bytes
    pub fallible slice(imm self: StringView, static A: type, static B: type, bounds: Range(A, B)) StringView
        const offsets = bounds.resolve?(self.byte_length())
        const start = offsets.0
        const end = offsets.1
        if start < self.byte_length()
            const first = byte_int(self.bytes.get?(start))
            if first >= 128 and first < 192 -> fail
        if end < self.byte_length()
            const last = byte_int(self.bytes.get?(end))
            if last >= 128 and last < 192 -> fail
        return StringView{bytes = self.bytes.slice?(bounds)}

struct LiteralBytes
    copy = trivial
    data: static_data
    size: int

struct OwnedBytes
    copy = none
    allocation: Allocation(byte)
    size: int
    drop = func(deinit self: OwnedBytes) -> deallocate(byte, self.allocation^)

pub struct String
    copy = none
    storage: LiteralBytes | OwnedBytes

    pub fallible ==(imm left: String, imm right: StringView) unit -> equal_bytes?(left.as_bytes(), right.as_bytes())
    pub fallible <>(imm left: String, imm right: StringView) unit -> not equal_bytes?(left.as_bytes(), right.as_bytes())
    pub fallible from_utf8(imm bytes: BytesView) String
        const text = bytes.validate_utf8?()
        var result = String.empty()
        result.append?(text)
        return result^
    pub func empty() String -> String{storage = LiteralBytes{data = literal_data(""), size = 0}}
    pub func byte_length(imm self: String) int
        if const literal = self.storage as LiteralBytes -> return literal.size
        if ref owned = self.storage as OwnedBytes -> return owned.size
        panic "invalid String storage"
    pub func capacity(imm self: String) int
        if const literal = self.storage as LiteralBytes -> return literal.size
        if ref owned = self.storage as OwnedBytes -> return owned.allocation.capacity()
        panic "invalid String storage"
    pub func as_bytes(imm self: String) BytesView
        if const literal = self.storage as LiteralBytes -> return BytesView{data = Span(byte).unsafe_from_static(literal.data, literal.size)}
        if ref owned = self.storage as OwnedBytes
            if const bytes = BytesView.unsafe_from_allocation(owned.allocation, owned.size) -> return bytes
        panic "invalid String byte view"
    pub func view(imm self: String) StringView -> StringView{bytes = self.as_bytes()}
    pub fallible reserve(mut self: String, minimum_capacity: int)
        minimum_capacity >= 0
        if minimum_capacity <= self.capacity() -> return
        const size = self.byte_length()
        var capacity = minimum_capacity
        if capacity < size -> capacity = size
        var replacement = OwnedBytes{allocation = allocate?(byte, capacity), size = 0}
        const bytes = self.as_bytes()
        var index = 0
        loop
            if index == size -> break
            const item = bytes.get?(index)
            unsafe_initialize?(byte, replacement.allocation, index, item)
            index += 1
        replacement.size = size
        self.storage = replacement^
    pub fallible append(mut self: String, imm text: StringView)
        const count = text.byte_length()
        if count == 0 -> return
        const size = self.byte_length()
        count <= 2147483647 - size
        const required = size + count
        var capacity = self.capacity()
        if capacity < required
            if capacity <= 1073741823 -> capacity *= 2
            else
                capacity = 2147483647
            if capacity < required -> capacity = required
        self.reserve?(capacity)
        const bytes = text.as_bytes()
        if ref owned = self.storage as OwnedBytes
            var index = 0
            loop
                if index == count -> break
                const item = bytes.get?(index)
                unsafe_initialize?(byte, owned.allocation, size + index, item)
                index += 1
            owned.size = required
            return
        panic "invalid String storage during append"
    pub fallible clone(imm self: String) String
        var result = String.empty()
        result.append?(self.view())
        return result^

fallible equal_bytes(imm left: BytesView, imm right: BytesView) unit
    const count = left.byte_length()
    if count <> right.byte_length() -> fail
    var index = 0
    loop
        if index == count -> return
        if const first = left.get(index)
            if const second = right.get(index)
                if byte_int(first) <> byte_int(second) -> fail
                index += 1
                continue
        panic "invalid text equality byte access"

pub converter(static value: string_literal) String -> String{storage = LiteralBytes{data = literal_data(value), size = literal_size(value)}}
pub converter(static value: string_literal) StringView -> StringView{bytes = BytesView{data = Span(byte).unsafe_from_static(literal_data(value), literal_size(value))}}
pub converter(static value: string_literal) BytesView -> BytesView{data = Span(byte).unsafe_from_static(literal_data(value), literal_size(value))}

pub converter(imm value: String) StringView -> value.view()
pub converter(imm value: String) BytesView -> value.as_bytes()
