import std.array.{Array}

struct StaticSortOrder(T: type, before: func(imm T, imm T) bool)
    pub func less(imm self: StaticSortOrder(T, before), imm left: T, imm right: T) bool -> before(left, right)

struct RuntimeSortOrder(F: type)
    ref before: F
    pub func less(imm self: RuntimeSortOrder(F), static T: type, imm left: T, imm right: T) bool -> self.before(left, right)

# Indexing below uses `unsafe_at`. Every index stays inside its list or view whatever the
# comparator returns: `order` is always a permutation of the source indices, and run,
# merge, and partition cursors only move within the range being sorted.

struct DriftRun
    copy = trivial
    first: int
    limit: int
    sorted: bool
    power: int

func natural_order(static T: type, imm left: T, imm right: T) bool -> left < right

func sort_span(static T: type, static Order: type, mut source: Span(T), imm before: Order) unit
    try_sort_span(T, Order, source, before) catch -> panic "sort scratch allocation failed"

func try_sort_span(static T: type, static Order: type, mut source: Span(T), imm before: Order) unit | AllocationError
    const length = source.len()
    if length < 2 -> return unit
    if length <= 20
        insertion_sort_slots(T, Order, source, before)
        return unit

    const descending = before.less(source[1], source[0])
    var run = 2
    loop
        if run == length -> break
        if before.less(source[run], source[run - 1]) <> descending -> break
        run += 1
    if run == length
        if descending -> source.reverse()
        return unit

    const scratch_provider = root_allocator()
    var order_storage = allocate_with(int, scratch_provider, length)?
    var scratch_storage = allocate_with(int, scratch_provider, length)
    if scratch_storage is AllocationError
        deallocate(int, order_storage^)
        return scratch_storage^
    var order = Span(int){data = allocation_cursor(int, order_storage), size = length}
    var scratch = Span(int){data = allocation_cursor(int, scratch_storage), size = length}
    # The permutation is fully initialized here; each algorithm initializes the
    # scratch range it will read. Neither buffer needs a preliminary zero fill.
    for index in 0..length
        order.unsafe_at(index) = index
    drift_indices(T, Order, source, order, scratch, before)
    apply_sort_order(T, source.data, order)
    deallocate(int, scratch_storage^)
    deallocate(int, order_storage^)
    return unit

func insertion_sort_slots(static T: type, static Order: type, mut source: Span(T), imm before: Order)
    for position in 1..source.len()
        var current = position
        loop
            if current == 0 -> break
            if not before.less(source[current], source[current - 1]) -> break
            swap_elements(T, source.data, current, current - 1)
            current -= 1

func sorted_span(static T: type, static Order: type, ref source: Span(T), imm before: Order) List(T) | AllocationError
    var result = List(T).new(source.len())?
    for const item in source
        append_collection_moved(T, result, item^)
    var view = result.span()
    _ = try_sort_span(T, Order, view, before)?
    return result^

func drift_indices(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), mut scratch: Span(int), imm before: Order)
    const length = source.len()
    const threshold = drift_run_threshold(length)
    var runs = Array(DriftRun, 64).filled(DriftRun{first = 0, limit = 0, sorted = false, power = 0})
    var count = 0
    var scan = 0
    loop
        if scan == length -> break
        const next = drift_next_run(T, Order, source, order, scan, threshold, before)
        if count > 0
            const power = drift_node_power(length, runs[count - 1].first, scan, next.limit)
            loop
                if count < 2 -> break
                if runs[count - 2].power < power -> break
                drift_merge_runs(T, Order, source, order, scratch, runs, count - 2, before)
                count -= 1
            runs[count - 1].power = power
        runs[count] = next
        count += 1
        scan = next.limit

    loop
        if count <= 1 -> break
        drift_merge_runs(T, Order, source, order, scratch, runs, count - 2, before)
        count -= 1
    if not runs[0].sorted
        drift_quicksort(T, Order, source, order, scratch, 0, length, drift_depth(length), -1, before)

func drift_run_threshold(length: int) int
    if length <= 4096
        const half = length - length / 2
        if half < 64 -> return half
        return 64
    var scaled = length
    var estimate = 1
    loop
        if scaled < 4 -> break
        scaled /= 4
        estimate *= 2
    return (estimate + length / estimate) / 2

func drift_next_run(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), first: int, threshold: int, imm before: Order) DriftRun
    const remaining = source.len() - first
    if remaining >= threshold
        const descending = before.less(source.unsafe_at(order.unsafe_at(first + 1)), source.unsafe_at(order.unsafe_at(first)))
        var limit = first + 2
        loop
            if limit == source.len() -> break
            if before.less(source.unsafe_at(order.unsafe_at(limit)), source.unsafe_at(order.unsafe_at(limit - 1))) <> descending -> break
            limit += 1
        if limit - first >= threshold
            if descending -> reverse_order(order, first, limit)
            return DriftRun{first = first, limit = limit, sorted = true, power = 0}
    var limit = source.len()
    if remaining > threshold -> limit = first + threshold
    return DriftRun{first = first, limit = limit, sorted = false, power = 0}

func reverse_order(mut order: Span(int), first: int, limit: int)
    for offset in 0..((limit - first) / 2)
        const left = first + offset
        const right = limit - 1 - offset
        const saved = order.unsafe_at(left)
        order.unsafe_at(left) = order.unsafe_at(right)
        order.unsafe_at(right) = saved

func drift_node_power(length: int, first: int, middle: int, limit: int) int
    const denominator = i64(length) * 2
    var left = i64(first) + i64(middle)
    var right = i64(middle) + i64(limit)
    var power = 0
    loop
        left *= 2
        right *= 2
        power += 1
        const left_high = left >= denominator
        const right_high = right >= denominator
        if left_high <> right_high -> return power
        if left_high
            left -= denominator
            right -= denominator

func drift_merge_runs(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), mut scratch: Span(int), mut runs: Array(DriftRun, 64), index: int, imm before: Order)
    const left = runs[index]
    const right = runs[index + 1]
    var sorted = false
    if left.sorted or right.sorted
        if not left.sorted
            drift_quicksort(T, Order, source, order, scratch, left.first, left.limit, drift_depth(left.limit - left.first), -1, before)
        if not right.sorted
            drift_quicksort(T, Order, source, order, scratch, right.first, right.limit, drift_depth(right.limit - right.first), -1, before)
        drift_merge(T, Order, source, order, scratch, left.first, left.limit, right.limit, before)
        sorted = true
    runs[index] = DriftRun{first = left.first, limit = right.limit, sorted = sorted, power = right.power}

func drift_depth(length: int) int
    var remaining = length
    var depth = 0
    loop
        if remaining <= 1 -> break
        remaining /= 2
        depth += 2
    return depth

func drift_quicksort(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), mut scratch: Span(int), first: int, limit: int, depth: int, ancestor: int, imm before: Order)
    var start = first
    var end = limit
    # Every iteration consumes depth, including non-splitting inconsistent comparisons.
    var remaining = depth
    var lower = ancestor
    loop
        const length = end - start
        if length <= 20
            insertion_sort_order(T, Order, source, order, start, end, before)
            return
        if remaining == 0
            drift_merge_sort(T, Order, source, order, scratch, start, end, before)
            return
        remaining -= 1
        const pivot = drift_pivot(T, Order, source, order, start, end, before)
        # The right partition's ancestor is a lower bound. Equal pivots need only
        # an equality partition; ordinary distinct pivots need only a less-than one.
        var equal = false
        if lower >= 0 -> equal = not before.less(source.unsafe_at(lower), source.unsafe_at(pivot))
        var middle = start
        if not equal
            middle = drift_partition(T, Order, source, order, scratch, start, end, pivot, false, before)
            equal = middle == start
        if equal
            start = drift_partition(T, Order, source, order, scratch, start, end, pivot, true, before)
            lower = -1
        else if middle - start < end - middle
            drift_quicksort(T, Order, source, order, scratch, start, middle, remaining, lower, before)
            start = middle
            lower = pivot
        else
            drift_quicksort(T, Order, source, order, scratch, middle, end, remaining, pivot, before)
            end = middle

func drift_pivot(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), first: int, limit: int, imm before: Order) int
    const length = limit - first
    const middle = first + length / 2
    const last = limit - 1
    var a = order.unsafe_at(first)
    var b = order.unsafe_at(middle)
    var c = order.unsafe_at(last)
    if length >= 128
        const step = length / 8
        a = drift_median(T, Order, source, a, order.unsafe_at(first + step), order.unsafe_at(first + step * 2), before)
        b = drift_median(T, Order, source, order.unsafe_at(middle - step), b, order.unsafe_at(middle + step), before)
        c = drift_median(T, Order, source, order.unsafe_at(last - step * 2), order.unsafe_at(last - step), c, before)
    return drift_median(T, Order, source, a, b, c, before)

func drift_median(static T: type, static Order: type, ref source: Span(T), a: int, b: int, c: int, imm before: Order) int
    if before.less(source.unsafe_at(a), source.unsafe_at(b))
        if before.less(source.unsafe_at(b), source.unsafe_at(c)) -> return b
        if before.less(source.unsafe_at(a), source.unsafe_at(c)) -> return c
        return a
    if before.less(source.unsafe_at(a), source.unsafe_at(c)) -> return a
    if before.less(source.unsafe_at(b), source.unsafe_at(c)) -> return c
    return b

func drift_partition(static T: type, static Order: type, ref input: Span(T), mut indices: Span(int), mut buffer: Span(int), first: int, limit: int, pivot: int, equal: bool, imm before: Order) int
    var source = input
    var order = indices
    var scratch = buffer
    var left = first
    var right = limit
    for position in first..limit
        const item = order.unsafe_at(position)
        if equal
            const selected = not before.less(source.unsafe_at(pivot), source.unsafe_at(item))
            if selected
                scratch.unsafe_at(left) = item
                left += 1
            else
                right -= 1
                scratch.unsafe_at(right) = item
        else
            # Both candidate slots are written and exactly one counter advances, so
            # the unpredictable comparison needs no branch. The slot before `right`
            # is only claimed by a later write, and the slots coincide for the last item.
            var claimed = 0
            if before.less(source.unsafe_at(item), source.unsafe_at(pivot)) -> claimed = 1
            scratch.unsafe_at(left) = item
            scratch.unsafe_at(right - 1) = item
            left += claimed
            right -= 1 - claimed
    var partitioned = cursor_offset(int, scratch.data, first)
    var destination = cursor_offset(int, order.data, first)
    copy_sort_indices(partitioned, destination, left - first)
    for position in left..limit
        const reversed = limit - 1 - (position - left)
        order.unsafe_at(position) = scratch.unsafe_at(reversed)
    return left

func insertion_sort_order(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), first: int, limit: int, imm before: Order)
    if first >= limit -> return
    for position in (first + 1)..limit
        const item = order.unsafe_at(position)
        var destination = position
        loop
            if destination == first -> break
            const previous = order.unsafe_at(destination - 1)
            if not before.less(source.unsafe_at(item), source.unsafe_at(previous)) -> break
            order.unsafe_at(destination) = previous
            destination -= 1
        order.unsafe_at(destination) = item

func drift_merge_sort(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), mut scratch: Span(int), first: int, limit: int, imm before: Order)
    const length = limit - first
    var width = 1
    loop
        if width >= length -> break
        var start = first
        loop
            if start == limit -> break
            var middle = limit
            if limit - start > width -> middle = start + width
            var end = limit
            if limit - middle > width -> end = middle + width
            if middle < end -> drift_merge(T, Order, source, order, scratch, start, middle, end, before)
            start = end
        if width > length / 2 -> break
        width *= 2

func drift_merge(static T: type, static Order: type, ref source: Span(T), mut order: Span(int), mut scratch: Span(int), first: int, middle: int, limit: int, imm before: Order)
    if not before.less(source.unsafe_at(order.unsafe_at(middle)), source.unsafe_at(order.unsafe_at(middle - 1))) -> return
    const reversed = before.less(source.unsafe_at(order.unsafe_at(limit - 1)), source.unsafe_at(order.unsafe_at(first)))
    if middle - first <= limit - middle
        drift_merge_forward(T, Order, source, order, scratch, first, middle, limit, reversed, before)
    else
        drift_merge_backward(T, Order, source, order, scratch, first, middle, limit, reversed, before)

func drift_merge_forward(static T: type, static Order: type, ref input: Span(T), mut indices: Span(int), mut buffer: Span(int), first: int, middle: int, limit: int, reversed: bool, imm before: Order)
    var source = input
    var order = indices
    var scratch = buffer
    const length = middle - first
    var from = cursor_offset(int, order.data, first)
    var to = scratch.data
    copy_sort_indices(from, to, length)
    var left = 0
    var right = middle
    var position = first
    if reversed
        var from_right = cursor_offset(int, order.data, middle)
        var to_first = cursor_offset(int, order.data, first)
        copy_sort_indices(from_right, to_first, limit - middle)
        position += limit - middle
    else
        loop
            if left == length or right == limit -> break
            const from_left = scratch.unsafe_at(left)
            const from_right = order.unsafe_at(right)
            if before.less(source.unsafe_at(from_right), source.unsafe_at(from_left))
                order.unsafe_at(position) = from_right
                right += 1
            else
                order.unsafe_at(position) = from_left
                left += 1
            position += 1
    var remaining = cursor_offset(int, scratch.data, left)
    var destination = cursor_offset(int, order.data, position)
    copy_sort_indices(remaining, destination, length - left)

func drift_merge_backward(static T: type, static Order: type, ref input: Span(T), mut indices: Span(int), mut buffer: Span(int), first: int, middle: int, limit: int, reversed: bool, imm before: Order)
    var source = input
    var order = indices
    var scratch = buffer
    const length = limit - middle
    var from = cursor_offset(int, order.data, middle)
    var to = scratch.data
    copy_sort_indices(from, to, length)
    var left = middle
    var right = length
    var position = limit
    if reversed
        var from_left = cursor_offset(int, order.data, first)
        var to_last = cursor_offset(int, order.data, first + length)
        copy_sort_indices_backward(from_left, to_last, middle - first)
        position = first + length
    else
        loop
            if left == first or right == 0 -> break
            const from_left = order.unsafe_at(left - 1)
            const from_right = scratch.unsafe_at(right - 1)
            position -= 1
            # Equal values from the right run go last, preserving stability.
            if before.less(source.unsafe_at(from_right), source.unsafe_at(from_left))
                order.unsafe_at(position) = from_left
                left -= 1
            else
                order.unsafe_at(position) = from_right
                right -= 1
    var remaining = scratch.data
    var destination = cursor_offset(int, order.data, position - right)
    copy_sort_indices(remaining, destination, right)

# Callers choose the direction so overlapping copies read each index before replacing it.
func copy_sort_indices(ref source: StorageCursor(int), mut destination: StorageCursor(int), length: int)
    var index = 0
    loop
        if index == length -> break
        cursor_element(int, destination, index) = cursor_element(int, source, index)
        index += 1

func copy_sort_indices_backward(ref source: StorageCursor(int), mut destination: StorageCursor(int), length: int)
    var index = length
    loop
        if index == 0 -> break
        index -= 1
        cursor_element(int, destination, index) = cursor_element(int, source, index)

func apply_sort_order(static T: type, mut source: StorageCursor(T), mut indices: Span(int))
    var cursor = source
    var order = indices
    for start in 0..order.len()
        if order.unsafe_at(start) <> start
            const saved = cursor_take(T, cursor, start)
            var destination = start
            loop
                const next = order.unsafe_at(destination)
                order.unsafe_at(destination) = destination
                if next == start
                    cursor_initialize(T, cursor, destination, saved^)
                    break
                const item = cursor_take(T, cursor, next)
                cursor_initialize(T, cursor, destination, item^)
                destination = next
