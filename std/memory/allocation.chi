import std.text.{BytesView}
import std.array.{Array, collection_literal}
import std.exit.{exit}

pub struct Allocation(T: type)
    storage: HostStorage
    count: int
    drop = explicit

    pub fallible allocate_raw(count: int) Allocation(T) -> allocate?(T, count)
    pub func release(deinit self: Allocation(T)) -> deallocate(T, self^)
    pub func capacity(imm self: Allocation(T)) int -> allocation_count(T, self)
    pub fallible unsafe_init(mut self: Allocation(T), index: int, init item: T) -> unsafe_initialize?(T, self, index, item)
    pub func unsafe_remove(mut self: Allocation(T), index: int) T -> unsafe_take(T, self, index)
    pub func unsafe_drop(mut self: Allocation(T), index: int) -> unsafe_destroy(T, self, index)
    pub func unsafe_ref(imm self: Allocation(T), index: int) Ref(T, false) -> unsafe_borrow_element(T, self, index)

pub extern fallible allocate(static T: type, count: int) Allocation(T)
pub extern func deallocate(static T: type, deinit allocation: Allocation(T))
extern func allocation_count(static T: type, imm allocation: Allocation(T)) int
pub extern fallible unsafe_initialize(static T: type, mut allocation: Allocation(T), index: int, init item: T)
pub extern func unsafe_take(static T: type, mut allocation: Allocation(T), index: int) T
pub extern func unsafe_destroy(static T: type, mut allocation: Allocation(T), index: int)
pub extern func unsafe_borrow_initialized(static T: type, imm allocation: Allocation(T), index: int) T

pub struct List(T: type)
    copy = none
    storage: Allocation(T)
    initialized: int
    drop = func(deinit self: List(T))
        var index = self.initialized
        loop
            if index == 0 -> break
            index -= 1
            unsafe_destroy(T, self.storage, index)
        deallocate(T, self.storage^)

    pub fallible from(static N: int, init values: collection_literal(T, N)) List(T)
        var result = List(T){storage = allocate?(T, N), initialized = 0}
        initialize_collection(T, N, result.storage, values)
        result.initialized = N
        return result^

    pub fallible new(reserved: int) List(T)
        const storage = allocate?(T, reserved)
        return List(T){storage = storage^, initialized = 0}

    pub func len(imm self: List(T)) int -> self.initialized
    pub func capacity(imm self: List(T)) int -> self.storage.capacity()
    pub func span(imm self: List(T)) Span(T, false) -> Span(T, false){data = allocation_cursor(T, self.storage), size = self.initialized}
    pub func span_mut(mut self: List(T)) Span(T, true) -> Span(T, true){data = allocation_cursor_mut(T, self.storage), size = self.initialized}
    pub fallible view(imm self: List(T), start: int, size: int) Span(T, false) -> self.span().slice?(start, size)
    pub fallible bytes(imm self: List(byte)) BytesView -> BytesView.unsafe_from_allocation?(self.storage, self.initialized)
    pub fallible read_bytes(mut self: List(byte), descriptor: int, count: int) int
        count >= 0
        count <= 2147483647 - self.initialized
        if count == 0 -> return 0
        self.reserve?(self.initialized + count)
        const actual = io_read?(descriptor, self.storage, self.initialized, count)
        self.initialized += actual
        return actual

    pub fallible reserve(mut self: List(T), minimum_capacity: int)
        minimum_capacity >= 0
        if minimum_capacity <= self.capacity() -> return
        var replacement = allocate?(T, minimum_capacity)
        const initialized = self.initialized
        var index = initialized
        loop
            if index == 0 -> break
            index -= 1
            var item = unsafe_take(T, self.storage, index)
            self.initialized = index
            if unsafe_initialize(T, replacement, index, item^) -> continue
            var cleanup = initialized
            loop
                if cleanup == index + 1 -> break
                cleanup -= 1
                unsafe_destroy(T, replacement, cleanup)
            deallocate(T, replacement)
            fail
        const previous = self.storage^
        self.storage = replacement^
        self.initialized = initialized
        deallocate(T, previous^)

    pub fallible append(mut self: List(T), var item: T)
        const capacity = self.capacity()
        if self.initialized == capacity
            capacity < 2147483647
            var next_capacity = 1
            if capacity > 0
                if capacity <= 1073741823 -> next_capacity = capacity * 2
                else next_capacity = 2147483647
            self.reserve?(next_capacity)
        unsafe_initialize?(T, self.storage, self.initialized, item^)
        self.initialized += 1

    pub fallible get(imm self: List(T), index: int) Ref(T, false)
        index >= 0
        index < self.initialized
        return unsafe_borrow_element(T, self.storage, index)

    pub fallible get_mut(mut self: List(T), index: int) Ref(T, true)
        index >= 0
        index < self.initialized
        return unsafe_borrow_mut_element(T, self.storage, index)

    pub fallible [](imm self: List(T), index: int) T
        const element = self.get?(index)
        return element[]

    pub fallible []=(mut self: List(T), index: int, var item: T) unit
        const element = self.get_mut?(index)
        element[] = item^

func allocate_literal(static T: type, count: int) Allocation(T)
    if const storage = allocate(T, count) -> return storage^
    exit(134)

extern func initialize_collection(static T: type, static N: int, mut storage: Allocation(T), init values: collection_literal(T, N))

pub converter(static T: type, static N: int, init values: collection_literal(T, N)) List(T)
    var result = List(T){storage = allocate_literal(T, N), initialized = 0}
    initialize_collection(T, N, result.storage, values)
    result.initialized = N
    return result^

pub struct Box(T: type)
    allocation: Allocation(T)
    drop = func(deinit self: Box(T))
        unsafe_destroy_box(T, self)
        deallocate_box(T, self^)

    pub fallible new(init item: T) Box(T)
        var storage = allocate?(T, 1)
        if unsafe_initialize(T, storage, 0, item)
            return unsafe_own_box(T, storage)
        else
            deallocate(T, storage)
            fail

    pub func borrow(imm self: Box(T)) Ref(T, false) -> borrow_box(T, self)
    pub func borrow_mut(mut self: Box(T)) Ref(T, true) -> borrow_mut_box(T, self)
    pub func into_value(deinit self: Box(T)) T -> value(T, self^)

struct StorageCursor(T: type, writable: bool)
    address_low: int
    address_high: int
    copy = trivial

pub struct Span(T: type, writable: bool)
    copy = trivial
    data: StorageCursor(T, writable)
    size: int

    pub func empty() Span(T, writable) -> Span(T, writable){data = empty_cursor(T, writable), size = 0}
    pub func from_array(static N: int, imm array: Array(T, N)) Span(T, false) -> Span(T, false){data = array_cursor(T, N, array), size = N}
    pub func from_array_mut(static N: int, mut array: Array(T, N)) Span(T, true) -> Span(T, true){data = array_cursor_mut(T, N, array), size = N}
    pub fallible unsafe_from_allocation(imm allocation: Allocation(T), initialized: int) Span(T, false)
        initialized >= 0
        initialized <= allocation.capacity()
        return Span(T, false){data = allocation_cursor(T, allocation), size = initialized}
    pub fallible unsafe_from_allocation_mut(mut allocation: Allocation(T), initialized: int) Span(T, true)
        initialized >= 0
        initialized <= allocation.capacity()
        return Span(T, true){data = allocation_cursor_mut(T, allocation), size = initialized}
    pub func unsafe_from_static(imm source: static_data, size: int) Span(byte, false) -> Span(byte, false){data = static_cursor(source), size = size}
    pub func len(imm self: Span(T, writable)) int -> self.size
    pub fallible get(imm self: Span(T, writable), index: int) Ref(T, false)
        index >= 0
        index < self.size
        return cursor_element(T, writable, false, self.data, index)
    pub fallible get_mut(imm self: Span(T, true), index: int) Ref(T, true)
        index >= 0
        index < self.size
        return cursor_element(T, true, true, self.data, index)
    pub fallible [](imm self: Span(T, writable), index: int) T
        const element = self.get?(index)
        return element[]
    pub fallible []=(imm self: Span(T, true), index: int, var item: T) unit
        const element = self.get_mut?(index)
        element[] = item^
    pub fallible slice(imm self: Span(T, writable), start: int, size: int) Span(T, writable)
        start >= 0
        size >= 0
        start <= self.size
        size <= self.size - start
        return Span(T, writable){data = cursor_offset(T, writable, self.data, start), size = size}
    pub func as_imm(imm self: Span(T, true)) Span(T, false) -> Span(T, false){data = cursor_attenuate(T, self.data), size = self.size}

extern func empty_cursor(static T: type, static writable: bool) StorageCursor(T, writable)
extern func static_cursor(imm source: static_data) StorageCursor(byte, false)
extern func array_cursor(static T: type, static N: int, imm array: Array(T, N)) StorageCursor(T, false)
extern func array_cursor_mut(static T: type, static N: int, mut array: Array(T, N)) StorageCursor(T, true)
extern func allocation_cursor(static T: type, imm allocation: Allocation(T)) StorageCursor(T, false)
extern func allocation_cursor_mut(static T: type, mut allocation: Allocation(T)) StorageCursor(T, true)
extern func cursor_offset(static T: type, static writable: bool, imm source: StorageCursor(T, writable), offset: int) StorageCursor(T, writable)
extern func cursor_element(static T: type, static source_writable: bool, static writable: bool, imm source: StorageCursor(T, source_writable), index: int) Ref(T, writable)
extern func cursor_attenuate(static T: type, imm source: StorageCursor(T, true)) StorageCursor(T, false)

pub struct Ref(T: type, writable: bool)
    cursor: StorageCursor(T, writable)
    copy = trivial

    pub func as_imm(imm self: Ref(T, true)) Ref(T, false) -> attenuate_ref(T, self)
    pub func read(imm self: Ref(T, writable)) T -> self[]
    pub func replace(imm self: Ref(T, true), var item: T) -> write(T, self, item^)

pub extern func borrow_box(static T: type, imm owner: Box(T)) Ref(T, false)
pub extern func borrow_mut_box(static T: type, mut owner: Box(T)) Ref(T, true)
pub extern func borrow_local(static T: type, imm item: T) Ref(T, false)
pub extern func unsafe_borrow_element(static T: type, imm allocation: Allocation(T), index: int) Ref(T, false)
extern func unsafe_borrow_mut_element(static T: type, imm allocation: Allocation(T), index: int) Ref(T, true)
pub extern func read(static T: type, static writable: bool, imm reference: Ref(T, writable)) T
pub extern func write(static T: type, imm reference: Ref(T, true), var item: T)
extern func attenuate_ref(static T: type, imm reference: Ref(T, true)) Ref(T, false)

pub func value(static T: type, deinit owner: Box(T)) T
    const result = unsafe_take_box(T, owner)
    deallocate_box(T, owner^)
    return result^

extern func unsafe_own_box(static T: type, deinit allocation: Allocation(T)) Box(T)
extern func unsafe_take_box(static T: type, mut owner: Box(T)) T
extern func unsafe_destroy_box(static T: type, imm owner: Box(T))
extern func deallocate_box(static T: type, deinit owner: Box(T))

extern fallible io_read(descriptor: int, imm allocation: Allocation(byte), start: int, count: int) int
