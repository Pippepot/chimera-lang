import std.iteration.{End}

pub struct Range(A: type, B: type)
    copy = trivial
    pub first: A
    pub limit: B
    inclusive: bool

    pub func iter(self: Range(int, int)) RangeIterator -> self.sequence().iter()
    pub func reversed(self: Range(int, int)) RangeSequence -> self.sequence().reversed()
    pub fallible step_by(self: Range(int, int), factor: int) RangeSequence -> self.sequence().step_by?(factor)

    pub fallible resolve(self: Range(A, B), length: int) (int, int)
        length >= 0
        const first: int | none = self.first
        const limit: int | none = self.limit
        var start = 0
        if const value = first as int -> start = value
        var end = length
        if const value = limit as int
            value >= 0
            if self.inclusive?
                start <= value
                value < length
                end = value + 1
            else
                value <= length
                end = value
        else
            not self.inclusive?
        start >= 0
        start <= end
        return (start, end)

    func sequence(self: Range(int, int)) RangeSequence
        if self.inclusive?
            return RangeSequence{first = self.first, last = self.limit, stride = 1, descending = false, empty = bool(self.first > self.limit)}
        if self.first >= self.limit
            return RangeSequence{first = self.first, last = self.first, stride = 1, descending = false, empty = true}
        return RangeSequence{first = self.first, last = self.limit - 1, stride = 1, descending = false, empty = false}

pub struct RangeSequence
    copy = trivial
    first: int
    last: int
    stride: int
    descending: bool
    empty: bool

    pub func iter(self: RangeSequence) RangeIterator
        return RangeIterator{
            value = self.first,
            last = self.last,
            stride = self.stride,
            descending = self.descending,
            started = false,
            finished = self.empty,
        }

    pub func reversed(self: RangeSequence) RangeSequence
        return RangeSequence{
            first = self.last,
            last = self.first,
            stride = self.stride,
            descending = not_direction(self.descending),
            empty = self.empty,
        }

    pub fallible step_by(self: RangeSequence, factor: int) RangeSequence
        factor > 0
        if self.empty? or factor == 1 -> return self
        if self.stride == 0 or not has_steps(self.first, self.last, self.stride, factor)?
            return RangeSequence{first = self.first, last = self.first, stride = 1, descending = self.descending, empty = false}
        const stride = self.stride * factor
        if self.stride > 2147483647 / factor
            const last = if self.descending? -> self.first - stride else self.first + stride
            return RangeSequence{first = self.first, last = last, stride = 0, descending = self.descending, empty = false}
        return RangeSequence{
            first = self.first,
            last = aligned_last(self.first, self.last, stride, self.descending),
            stride = stride,
            descending = self.descending,
            empty = false,
        }

pub struct RangeIterator
    copy = trivial
    value: int
    last: int
    stride: int
    descending: bool
    started: bool
    finished: bool

    pub func next(mut self: RangeIterator) int | End
        if self.finished? -> return End{}
        if self.started?
            if self.value == self.last
                self.finished = true
                return End{}
            if self.stride == 0 -> self.value = self.last
            else if self.descending? -> self.value -= self.stride
            else self.value += self.stride
        self.started = true
        return self.value

pub func exclusive(static A: type, static B: type, first: A, limit: B) Range(A, B)
    return Range(A, B){first = first, limit = limit, inclusive = false}

pub func inclusive(static A: type, static B: type, first: A, limit: B) Range(A, B)
    return Range(A, B){first = first, limit = limit, inclusive = true}

func not_direction(value: bool) bool
    if value? -> return false
    return true

func has_steps(first: int, last: int, stride: int, count: int) bool
    const low = if first < last -> first else last
    const high = if first < last -> last else first
    if low >= 0 or high < 0 -> return bool((high - low) / stride >= count)
    const left = -(low + 1)
    const right = high
    const left_steps = left / stride
    if left_steps >= count -> return true
    const remaining = count - left_steps
    const right_steps = right / stride
    if right_steps >= remaining -> return true
    if remaining - right_steps <> 1 -> return false
    return bool(left % stride >= stride - 1 - right % stride)

func aligned_last(first: int, last: int, stride: int, descending: bool) int
    var first_remainder = first % stride
    if first_remainder < 0 -> first_remainder += stride
    var last_remainder = last % stride
    if last_remainder < 0 -> last_remainder += stride
    const left = if descending? -> first_remainder else last_remainder
    const right = if descending? -> last_remainder else first_remainder
    const remainder = if left >= right -> left - right else stride - (right - left)
    if descending? -> return last + remainder
    return last - remainder