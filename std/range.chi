import std.memory.{AllocationError}
import std.text.{String, integer_text}
import std.iteration.{End}

pub struct FromEnd
    copy = trivial
    distance: int
    pub func resolve(self: FromEnd, length: int) int | none
        if length < 0 or self.distance < 0 or self.distance > length -> return none
        return length - self.distance
pub func from_end(distance: int) FromEnd -> FromEnd{distance = distance}

pub struct Range
    copy = fieldwise
    pub first: int | FromEnd | none
    pub limit: int | FromEnd | none
    inclusive: bool
    pub func contains(imm self: Range, imm value: int) bool
        const first = self.first
        if not (first is int) -> return false
        const limit = self.limit
        if not (limit is int) -> return false
        return value >= first and (if self.inclusive -> value <= limit else value < limit)
    pub func iter(self: Range) RangeIterator
        const sequence = self.sequence()
        if not (sequence is RangeSequence) -> panic "range iteration requires both endpoints as absolute integers"
        return sequence.iter()
    pub func reversed(self: Range) RangeSequence
        const sequence = self.sequence()
        if not (sequence is RangeSequence) -> panic "range reversal requires both endpoints as absolute integers"
        return sequence.reversed()
    pub func step_by(self: Range, factor: int) RangeSequence | none
        const sequence = self.sequence()
        if not (sequence is RangeSequence) -> return none
        return sequence.step_by(factor)
    pub func resolve(self: Range, length: int) (int, int) | none
        if length < 0 -> return none
        const start = resolve_bound(self.first, length, 0)
        if not (start is int) -> return none
        const limit = resolve_bound(self.limit, length, length)
        if not (limit is int) -> return none
        if start < 0 or start > limit -> return none
        if self.inclusive
            if self.limit is none or limit >= length -> return none
            return (start, limit + 1)
        if limit > length -> return none
        return (start, limit)
    func sequence(self: Range) RangeSequence | none
        const first = self.first
        if not (first is int) -> return none
        const limit = self.limit
        if not (limit is int) -> return none
        if self.inclusive
            return RangeSequence{first = first, last = limit, stride = 1, descending = false, empty = first > limit}
        if first >= limit
            return RangeSequence{first = first, last = first, stride = 1, descending = false, empty = true}
        return RangeSequence{first = first, last = limit - 1, stride = 1, descending = false, empty = false}

pub struct RangeSequence
    copy = trivial
    first: int
    last: int
    stride: int
    descending: bool
    empty: bool

    pub func iter(self: RangeSequence) RangeIterator
        # A zero stride is a single jump from first to last. Every step lands on
        # last exactly, so wrapping addition never leaves the sequence.
        var step = self.stride
        if self.stride == 0 -> step = wrapping(self.last - self.first)
        else if self.descending -> step = -self.stride
        return RangeIterator{value = self.first, last = self.last, step = step, finished = self.empty}

    pub func reversed(self: RangeSequence) RangeSequence
        return RangeSequence{
            first = self.last,
            last = self.first,
            stride = self.stride,
            descending = not self.descending,
            empty = self.empty,
        }

    pub func step_by(self: RangeSequence, factor: int) RangeSequence | none
        if factor <= 0 -> return none
        if self.empty or factor == 1 -> return self
        if self.stride == 0 or not has_steps(self.first, self.last, self.stride, factor)
            return RangeSequence{first = self.first, last = self.first, stride = 1, descending = self.descending, empty = false}
        const stride = wrapping(self.stride * factor)
        if self.stride > 2147483647 / factor
            const last = if self.descending -> wrapping(self.first - stride) else wrapping(self.first + stride)
            return RangeSequence{first = self.first, last = last, stride = 0, descending = self.descending, empty = false}
        return RangeSequence{
            first = self.first,
            last = aligned_last(self.first, self.last, stride, self.descending),
            stride = stride,
            descending = self.descending,
            empty = false,
        }

pub struct RangeIterator
    copy = trivial
    value: int
    last: int
    step: int
    finished: bool

    pub func next(mut self: RangeIterator) int | End
        if self.finished -> return End{}
        const value = self.value
        if value == self.last -> self.finished = true
        else self.value = wrapping(value + self.step)
        return value

pub func exclusive(first: int | FromEnd | none, limit: int | FromEnd | none) Range
    return Range{first = first, limit = limit, inclusive = false}

pub func inclusive(first: int | FromEnd | none, limit: int | FromEnd | none) Range
    return Range{first = first, limit = limit, inclusive = true}

pub converter(imm value: Range) String -> format_range(value) catch -> panic "string conversion allocation failed"
func format_range(imm value: Range) String | AllocationError
    var result = String.empty()
    _ = append_bound(result, value.first)?
    _ = result.append("..")?
    if value.inclusive
        _ = result.append("=")?
    _ = append_bound(result, value.limit)?
    return result^
func resolve_bound(bound: int | FromEnd | none, length: int, omitted: int) int | none
    return match bound
        int -> bound
        FromEnd -> bound.resolve(length)
        none -> omitted
func append_bound(mut result: String, bound: int | FromEnd | none) unit | AllocationError
    match bound
        int -> return result.append(integer_text(bound).view())
        FromEnd ->
            _ = result.append("^")?
            return result.append(integer_text(bound.distance).view())
        none -> return unit

func has_steps(first: int, last: int, stride: int, count: int) bool
    const low = if first < last -> first else last
    const high = if first < last -> last else first
    if low >= 0 or high < 0 -> return (high - low) / stride >= count
    const left = -(low + 1)
    const right = high
    const left_steps = left / stride
    if left_steps >= count -> return true
    const remaining = count - left_steps
    const right_steps = right / stride
    if right_steps >= remaining -> return true
    if remaining - right_steps <> 1 -> return false
    return left % stride >= stride - 1 - right % stride

func aligned_last(first: int, last: int, stride: int, descending: bool) int
    var first_remainder = first % stride
    if first_remainder < 0 -> first_remainder += stride
    var last_remainder = last % stride
    if last_remainder < 0 -> last_remainder += stride
    const left = if descending -> first_remainder else last_remainder
    const right = if descending -> last_remainder else first_remainder
    const remainder = if left >= right -> left - right else stride - (right - left)
    if descending -> return last + remainder
    return last - remainder
