import std.exit.{exit}
import std.memory.{List, AllocationError}
import std.text.{BytesView, String, StringView}

pub struct IoError
    error = true
    copy = fieldwise
    pub cause: int
    pub progress: int

pub struct Stream
    copy = trivial
    descriptor: int

pub static stdin = Stream{descriptor = 0}
pub static stdout = Stream{descriptor = 1}
pub static stderr = Stream{descriptor = 2}

pub func unhandled_error() never
    _ = write_text(stderr, "unhandled error\n")
    exit(1)

pub func write_once(stream: Stream, imm bytes: BytesView) int | IoError -> bytes.write_to(stream.descriptor)
pub func write_all(stream: Stream, imm bytes: BytesView) unit | IoError
    return write_all_to(stream.descriptor, bytes)
pub func write_all_to(descriptor: int, imm bytes: BytesView) unit | IoError
    var offset = 0
    loop
        if offset == bytes.byte_length() -> return unit
        const remaining = bytes.slice(offset..)
        if not (remaining is BytesView) -> panic "invalid write cursor"
        const written = remaining.write_to(descriptor)
        if written is IoError -> return IoError{cause = written.cause, progress = offset + written.progress}
        if written <= 0 -> return IoError{cause = 5, progress = offset}
        offset += written
pub func write_text(stream: Stream, imm text: StringView) unit | IoError -> write_all(stream, text.as_bytes())
pub overload print(print_value)
func print_value(static T: type, imm value: T)
    write_text(stdout, String(value)) catch -> panic "standard output write failed"
    write_text(stdout, "\n") catch -> panic "standard output newline write failed"
pub func read_bytes(stream: Stream, mut bytes: List(byte), count: int) int | AllocationError | IoError -> bytes.read_bytes(stream.descriptor, count)
