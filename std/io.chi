import std.memory.{List}
import std.text.{BytesView, StringView}
import std.exit.{exit}

pub struct Stream
    copy = trivial
    descriptor: int

pub static stdin = Stream{descriptor = 0}
pub static stdout = Stream{descriptor = 1}
pub static stderr = Stream{descriptor = 2}

pub fallible write_once(stream: Stream, imm bytes: BytesView) int -> bytes.write_to?(stream.descriptor)
pub fallible write_all(stream: Stream, imm bytes: BytesView)
    var offset = 0
    loop
        if offset == bytes.byte_length() -> break
        const remaining = bytes.slice?(offset, bytes.byte_length() - offset)
        const written = write_once?(stream, remaining)
        written > 0
        offset += written
pub fallible write_text(stream: Stream, imm text: StringView) -> write_all?(stream, text.as_bytes())
pub func print(imm text: StringView)
    if not write_text(stdout, text) -> exit(134)
    if not write_text(stdout, "\n") -> exit(134)
pub fallible read_bytes(stream: Stream, mut bytes: List(byte), count: int) int -> bytes.read_bytes?(stream.descriptor, count)
